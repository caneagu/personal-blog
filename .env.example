# Copy this file to .env and replace placeholder values before deployment.

# Published port on the host machine
HOST_PORT=8080

# Host paths for persistent writable data. Keep defaults for local/dev.
# On servers where you publish content, set absolute paths outside the git checkout.
BLOG_CONTENT_DIR=./content
BLOG_UPLOADS_DIR=./static/uploads

# Required secrets/auth
BLOG_SECRET_KEY=replace-with-a-long-random-secret
BLOG_ADMIN_USER=admin
BLOG_ADMIN_PASSWORD_HASH=pbkdf2:sha256:replace-with-generated-hash
BLOG_TRUSTED_HOSTS=blog.example.com,.example.com
BLOG_TRUST_PROXY_HEADERS=0

# Security/runtime defaults
BLOG_SECURE_COOKIES=1
BLOG_DEBUG=0

# Optional tuning
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_LOG_LEVEL=info
